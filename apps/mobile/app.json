{
  "expo": {
    "name": "Kalo",
    "slug": "kalo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hamzahhajji.kalo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#158054",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hamzahhajji.kalo",
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Kalo nutzt die Kamera, um Barcodes zu scannen und Fotos deiner Mahlzeiten zu analysieren.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalo greift auf deine Fotos zu, wenn du ein Bild deiner Mahlzeit zur Analyse auswählst.",
          "cameraPermission": "Kalo nutzt die Kamera, um Fotos deiner Mahlzeiten zu analysieren.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "kalo",
    "experiments": {
      "typedRoutes": true
    },
    "description": "KI-Kalorien- und Makro-Tracker: Foto, Barcode, Suche und adaptiver Ziel-Coach."
  }
}
