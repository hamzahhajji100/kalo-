# ── App (apps/mobile) ─────────────────────────────────────────────
# Public values only – EXPO_PUBLIC_* are bundled into the app.
# URL of the Kalo API (Cloudflare Worker or local `pnpm --filter @kalo/api dev:node`).
# Without it, photo recognition, label reading and USDA barcode lookup are disabled.
EXPO_PUBLIC_API_URL=http://localhost:8787

# ── API (apps/api) ────────────────────────────────────────────────
# Secrets: for the Worker use `wrangler secret put <NAME>`; for local dev put them in apps/api/.dev.vars.
ANTHROPIC_API_KEY=sk-ant-...
# Model for photo/label analysis (default claude-opus-5-5) and effort (low = fastest).
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Long random string used to sign anonymous device tokens.
TOKEN_SECRET=change-me
# https://fdc.nal.usda.gov/api-key-signup – DEMO_KEY works for testing (low rate limit).
USDA_API_KEY=DEMO_KEY
# Per-device daily limits to keep AI costs predictable.
PHOTO_DAILY_LIMIT=30
LABEL_DAILY_LIMIT=30
